# Salin ke .env.local (JANGAN di-commit). Nilai asli hanya di secret manager / dashboard hosting.
DATABASE_URL="postgresql://user:password@localhost:5432/jasa"

# Payment gateway (isi dari dashboard masing-masing; pakai mode TEST/sandbox dulu)
XENDIT_SECRET_KEY=""
XENDIT_CALLBACK_TOKEN=""
TRIPAY_API_KEY=""
TRIPAY_PRIVATE_KEY=""
TRIPAY_MERCHANT_CODE=""
TRIPAY_MODE="sandbox"

# Cron (Vercel Cron / GitHub Actions memanggil /api/cron dengan header Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# Notifikasi
WA_API_URL=""
WA_API_TOKEN=""
RESEND_API_KEY=""

# Opsional: lokasi config fee bila struktur folder berbeda
# FEE_CONFIG_PATH="/abs/path/config/fee.json"

# Mode empat mata saat tim masih 1 orang (lihat docs/21-enterprise.md §2)
MODE_SATU_ORANG="true"
